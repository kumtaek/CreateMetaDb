        S5["5단계: API 진입점 분석"]
    end

    subgraph Phase3 ["3. 연관관계 구축"]
        S6["6단계: 프론트엔드 분석"]
        S7["7단계: 무결성 검증"]
    end

    Phase1 --> Phase2 --> Phase3

    style Phase1 fill:#e3f2fd
    style Phase2 fill:#fff8e1
    style Phase3 fill:#e8f5e9
